    {"type":"text","id":"n5_t","x":80,"y":490,"width":190,"height":56,"text":"⑤ 큐레이터 (유휴 시)\n에이전트 생성 스킬 리뷰\npin · archive · consolidate","originalText":"5","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":310019,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"n5","lineHeight":1.3},

