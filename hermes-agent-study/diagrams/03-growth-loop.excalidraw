    {"type":"text","id":"n3_t","x":690,"y":490,"width":190,"height":56,"text":"③ 영속 메모리 기록\nMEMORY.md · USER.md\n(memory nudge ~N턴마다)","originalText":"3","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":310015,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"n3","lineHeight":1.3},

