    {"type":"text","id":"title","x":40,"y":24,"width":1100,"height":36,"text":"성장 루프: \"The agent that grows with you\"","originalText":"t","fontSize":28,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":310001,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":40,"y":66,"width":1150,"height":22,"text":"경험을 메모리·스킬로 영속화하고, 큐레이터가 다듬고, 다음 세션 시작 때 다시 주입한다. 모델 가중치는 그대로지만 '컨텍스트와 도구'가 누적되어 점점 나아진다.","originalText":"s","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":310002,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

