    {"type":"text","id":"n1_t","x":375,"y":140,"width":190,"height":56,"text":"① 세션 중 경험\n대화 · 툴 결과 · 피드백\n(episodic, 단기 컨텍스트)","originalText":"1","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#7c2d12","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":310011,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"n1","lineHeight":1.3},

