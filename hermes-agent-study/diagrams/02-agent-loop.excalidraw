    {"type":"text","id":"think_note","x":325,"y":410,"width":785,"height":50,"text":"추론: 모델이 native thinking 또는 <think>…</think> 토큰을 내면 분리 저장하고 다음 턴에 reasoning_content 로 replay.\nAnthropic 은 시스템 + 최근 메시지에 prompt cache(cache_control) 적용 → 입력 토큰 대폭 절감.","originalText":"n","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":210038,"version":1,"versionNonce":1,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},

